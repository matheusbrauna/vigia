{
  "name": "vigia",
  "description": "Alarme que avisa quando uma ferramenta de IA volta a treinar com as suas conversas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@wxt-dev/module-svelte": "^2.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wxt": "^0.21.5"
  }
}
